# AgroHub environment variables
# Copy this file to `.env.local` and fill in your values.

# Required for AI disease/pest analysis (https://console.groq.com/keys)
GROQ_API_KEY=gsk-your-key-here

# Vision model used for image analysis (Groq)
GROQ_MODEL=qwen/qwen3.6-27b

# Optional: fall back to OpenAI if GROQ_API_KEY is not set
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Optional PostgreSQL connection string (used by lib/db)
DATABASE_URL=postgres://user:password@host:5432/database

# Public site URL (used for sitemap/robots/metadata)
NEXT_PUBLIC_SITE_URL=https://agrohub.onrender.com

# Server port (used by scripts/start.js)
PORT=3000
